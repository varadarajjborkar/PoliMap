# Copy this file to `.env` (same folder) and fill in your key.
#   cp backend/.env.example backend/.env
# `.env` is gitignored and will never be committed.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "ollama" | "anthropic" | "offline" | "auto"
# auto -> picks the first provider that has credentials and responds.
POLIMAP_PROVIDER=auto

# Ollama Cloud, get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# Optional alternate provider
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model roles. Each is a comma-separated fallback chain, tried left to right.
# Leave blank to use the built-in defaults in app/core/config.py.
# ---------------------------------------------------------------------------
MODEL_EXTRACT=
MODEL_CHALLENGE=
MODEL_ADJUDICATE=
MODEL_VISION_OCR=
MODEL_NARRATE=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LLM_CACHE_ENABLED=true          # cache responses so re-runs are free and fast
LLM_TIMEOUT_SECONDS=120
MAX_CHALLENGE_ROUNDS=3
OCR_CONFIDENCE_THRESHOLD=0.72   # below this, escalate the page to a vision model

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# "sqlite" survives a restart, so a reload does not lose a document that took a
# minute to read. "memory" is faster and holds nothing, which is what the tests
# want. On a deployment with an ephemeral filesystem, sqlite still works within
# the life of the instance; mount a volume at data/ to outlive a redeploy.
SESSION_STORE=sqlite
SESSION_DB_PATH=                # blank -> data/polimap.db
SESSION_TTL_MINUTES=720         # sessions and their page images expire after this
SESSION_LIMIT=500               # hard cap on rows, a backstop under the expiry

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Browser origins allowed to call this API, comma separated. localhost:5173 and
# localhost:4173 are always allowed. A deployed frontend must be listed here or
# every request it makes is blocked by the browser.
#   CORS_ORIGINS=https://polimap.vercel.app
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Protection
# ---------------------------------------------------------------------------
# Set TRUST_PROXY only where a reverse proxy really terminates in front of this
# (Render, Railway, Fly, a load balancer). The caller's real address arrives in
# X-Forwarded-For there. Anywhere else that header is written by whoever is
# calling, so trusting it hands every caller a fresh rate-limit allowance per
# request, which is the same as having no rate limit at all.
TRUST_PROXY=false

# Turns on HSTS. Only true where TLS terminates: over plain HTTP the header is
# ignored, and from a development server it would pin localhost to HTTPS in
# your own browser for a year.
BEHIND_TLS=false

# /docs, /redoc and /openapi.json. A complete map of every route and every
# accepted field, which is a gift while building and a head start for anybody
# else, so it is off unless asked for.
ENABLE_DOCS=false

# The rate limit. Leave it on. Off is for the test suite, which is one caller
# making thousands of requests.
RATE_LIMIT_ENABLED=true

# What one uploaded document may ask for. Every page that is not already text
# is rasterised and put through OCR, so a small file declaring thousands of
# pages, or one page the size of a wall, is hours of work requested in a single
# request. No real policy or bill comes near these.
MAX_DOCUMENT_PAGES=60
MAX_PAGE_MEGAPIXELS=40          # a page above this is rasterised lower, not refused
MAX_IMAGE_MEGAPIXELS=60         # above any phone camera; a photo never meets it

# Activity streams held open at once, across everybody.
MAX_EVENT_STREAMS=200
