# Copy this file to `.env` (same folder) and fill in your key.
#   cp backend/.env.example backend/.env
# `.env` is gitignored and will never be committed.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "ollama" | "anthropic" | "offline" | "auto"
# auto -> picks the first provider that has credentials and responds.
COVERPATH_PROVIDER=auto

# Ollama Cloud — get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# Optional alternate provider
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model roles. Each is a comma-separated fallback chain, tried left to right.
# Leave blank to use the built-in defaults in app/core/config.py.
# ---------------------------------------------------------------------------
MODEL_EXTRACT=
MODEL_CHALLENGE=
MODEL_ADJUDICATE=
MODEL_VISION_OCR=
MODEL_NARRATE=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LLM_CACHE_ENABLED=true          # cache responses so re-runs are free and fast
LLM_TIMEOUT_SECONDS=120
MAX_CHALLENGE_ROUNDS=3
OCR_CONFIDENCE_THRESHOLD=0.72   # below this, escalate the page to a vision model
