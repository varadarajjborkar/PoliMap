# The corpus is rebuilt inside the image; shipping the local copy would add
# 80 MB of policy documents the running service never opens.
data/

.git/
.venv/
venv/
node_modules/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Nothing outside backend/ and datagen/ is copied into the image, and the
# whole tree is still sent to the builder before the COPY lines are read.
# The frontend alone is 74 MB of it.
frontend/
bench/
docs/
assets/
scripts/
.github/
README.md

.env
*.db
*.sqlite3
.DS_Store
